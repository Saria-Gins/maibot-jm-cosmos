{
  "manifest_version": 2,
  "id": "github.saria-gins.maibot-jm-cosmos",
  "version": "1.1.4",
  "name": "JM-Cosmos for MaiBot",
  "description": "JM 漫画下载插件：搜索、榜单、推荐、下载单行本并打包为 PDF 发送。移植自 GEMILUXVII 的 astrbot_plugin_jm_cosmos。",
  "author": {
    "name": "Saria-Gins",
    "url": "https://github.com/Saria-Gins"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "homepage": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "documentation": "https://github.com/Saria-Gins/maibot-jm-cosmos/blob/main/README.md",
    "issues": "https://github.com/Saria-Gins/maibot-jm-cosmos/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.17.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.6.10"
    },
    {
      "type": "python_package",
      "name": "pymupdf",
      "version_spec": ">=1.23.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
