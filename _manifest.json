{
  "manifest_version": 2,
  "version": "1.1.6",
  "name": "JM-Cosmos for MaiBot",
  "description": "JM 漫画下载：搜索、查看详情、下载单行本并打包成 PDF 发送。由 AstrBot 版 astrbot_plugin_jm_cosmos 移植。",
  "author": {
    "name": "GEMILUXVII (port by DSH)",
    "url": "https://github.com/GEMILUXVII/astrbot_plugin_jm_cosmos"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "homepage": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "documentation": "https://github.com/Saria-Gins/maibot-jm-cosmos/blob/main/README.md",
    "issues": "https://github.com/Saria-Gins/maibot-jm-cosmos/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.17.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.6.10"
    },
    {
      "type": "python_package",
      "name": "pymupdf",
      "version_spec": ">=1.23.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.saria-gins.maibot-jm-cosmos",
  "plugin_type": "tool"
}
