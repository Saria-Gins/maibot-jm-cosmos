{
  "manifest_version": 2,
  "id": "github.saria-gins.maibot-jm-cosmos",
  "version": "2.0.0",
  "name": "JM-Cosmos Metadata",
  "description": "JM 漫画元数据查询：搜索、详情、榜单、推荐。只读查询，不下载、不打包、不发送文件。移植自 GEMILUXVII 的 astrbot_plugin_jm_cosmos 查询部分。",
  "author": {
    "name": "Saria-Gins",
    "url": "https://github.com/Saria-Gins"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "homepage": "https://github.com/Saria-Gins/maibot-jm-cosmos",
    "documentation": "https://github.com/Saria-Gins/maibot-jm-cosmos/blob/main/README.md",
    "issues": "https://github.com/Saria-Gins/maibot-jm-cosmos/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.17.99"
  },
  "dependencies": [
    { "type": "python_package", "name": "jmcomic", "version_spec": ">=2.6.10,<3" }
  ],
  "capabilities": [
    "send.text"
  ],
  "plugin_type": "tool",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}